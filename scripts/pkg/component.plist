<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<array>
    <dict>
        <key>RootRelativeBundlePath</key>
        <string>RIMES.app</string>
        <key>BundleHasStrictIdentifier</key>
        <!-- Rename-period dev builds used RIMES.app as com.scholay.isaac.
             preinstall rejects every unrelated occupant before this
             deliberate identifier migration; relocatability remains
             disabled. Pre-rename ETInput.app bundles live at another path
             and are retired by postinstall. -->
        <false/>
        <key>BundleIsRelocatable</key>
        <false/>
        <key>BundleIsVersionChecked</key>
        <true/>
        <key>BundleOverwriteAction</key>
        <string>upgrade</string>
    </dict>
</array>
</plist>
