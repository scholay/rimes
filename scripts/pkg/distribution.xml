<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>RIMES</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <readme file="readme.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="RIMES">
        <pkg-ref id="com.isaac.inputmethod.RimeBuffer"/>
    </choice>
    <!-- make-pkg.sh requires this sole zero-version placeholder and stamps the
         validated release version before productbuild. -->
    <pkg-ref id="com.isaac.inputmethod.RimeBuffer" version="0" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
